# Required for Docker/server mode.
JKG_AUTH_TOKEN=replace-with-a-long-random-token

JKG_ENV=production

# Production storage. The compose file provides this default Postgres service.
JKG_DATABASE_URL=postgresql://jkg:jkg-local-dev-password@postgres:5432/jkg
JKG_TENANT_ID=default

# Optional legacy SQLite local/dev path when JKG_DATABASE_URL is not set.
JKG_DB_PATH=/data/memory_v3.db

POSTGRES_DB=jkg
POSTGRES_USER=jkg
POSTGRES_PASSWORD=jkg-local-dev-password

# Real provider credentials. Set only for the providers you intentionally use.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Current defaults.
JKG_LLM_MODEL=deepseek-v4-flash
JKG_EMBEDDING_MODEL=gemini-embedding-001
