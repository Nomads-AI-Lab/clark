# Required for Docker/server mode.
JKG_AUTH_TOKEN=replace-with-a-long-random-token

# SQLite server mode path inside the container volume.
JKG_DB_PATH=/data/memory_v3.db
JKG_ENV=production

# Real provider credentials. Set only for the providers you intentionally use.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Current defaults.
JKG_LLM_MODEL=deepseek-v4-flash
JKG_EMBEDDING_MODEL=gemini-embedding-001

