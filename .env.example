# Required for Docker/server mode.
CLARK_AUTH_TOKEN=replace-with-a-long-random-token

CLARK_ENV=production

# Production storage. The compose file provides this default Postgres service.
CLARK_DATABASE_URL=postgresql://clark:clark-local-dev-password@postgres:5432/clark
CLARK_TENANT_ID=default

# Optional legacy SQLite local/dev path when CLARK_DATABASE_URL is not set.
CLARK_DB_PATH=/data/memory_v3.db

POSTGRES_DB=clark
POSTGRES_USER=clark
POSTGRES_PASSWORD=clark-local-dev-password

# Real provider credentials. Set only for the providers you intentionally use.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Current defaults.
CLARK_LLM_MODEL=deepseek-v4-flash
CLARK_EMBEDDING_MODEL=gemini-embedding-001
